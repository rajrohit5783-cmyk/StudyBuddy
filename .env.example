NODE_ENV=development
PORT=8787
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-characters
# Mount a persistent disk at this path in production (for example /var/data)
DATA_DIR=./data
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
# Optional AI endpoint. Leave unset to use the built-in study coach/quiz fallbacks.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
# Comma-separated browser origins. In production, set this to your frontend URL.
CORS_ORIGINS=http://localhost:5173
