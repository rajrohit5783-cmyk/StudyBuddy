NODE_ENV=development
PORT=8787
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-characters
# Local storage paths; Render free services use ephemeral storage unless an external DB is configured.
DATA_DIR=./data
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
# Groq AI (keep the API key server-side; never expose it in Vite/frontend variables)
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
# Comma-separated browser origins. In production, set this to your frontend URL.
CORS_ORIGINS=http://localhost:5173
